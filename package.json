{
  "name": "crossbox-gym",
  "version": "0.1.0",
  "scripts": {
    "build": "npm run build:ui && tsc",
    "build:ui": "node scripts/build-ui.mjs",
    "dev:hero": "vite --config frontend/hero/vite.config.ts",
    "dev:app": "vite --config frontend/app/vite.config.ts",
    "dev:admin": "vite --config frontend/admin/vite.config.ts",
    "cdk:synth": "cdk synth",
    "deploy:ui": "node scripts/deploy-ui.mjs",
    "deploy": "node scripts/deploy.mjs",
    "destroy": "node scripts/destroy.mjs",
    "cdk": "cdk",
    "format": "prettier --write \"{bin,lib,scripts,frontend,test,integration-tests,ui-tests}/**/*.{css,html,js,mjs,ts,tsx}\" \"*.{json,mjs,ts}\" .prettierrc.json",
    "format:check": "prettier --check \"{bin,lib,scripts,frontend,test,integration-tests,ui-tests}/**/*.{css,html,js,mjs,ts,tsx}\" \"*.{json,mjs,ts}\" .prettierrc.json",
    "lint": "eslint --max-warnings=0 bin lib scripts frontend test integration-tests ui-tests",
    "typecheck": "tsc --noEmit && tsc --noEmit --project frontend/app/tsconfig.json && tsc --noEmit --project frontend/admin/tsconfig.json && tsc --noEmit --project frontend/hero/tsconfig.json",
    "test": "npm run test:unit",
    "test:unit": "tsx --test test/**/*.test.ts",
    "test:coverage": "c8 --all --extension .ts --include=lib/handlers/shared/** --reporter=text --reporter=lcov tsx --test test/**/*.test.ts",
    "test:stripe:live": "node scripts/run-stripe-live-test.mjs",
    "test:all": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run cdk:synth",
    "test:integration": "node scripts/run-integration-tests.mjs",
    "test:integration:fast": "node scripts/run-integration-tests.mjs",
    "test:integration:full": "npm run deploy && node scripts/run-integration-tests.mjs",
    "test:iot": "node --import tsx --test integration-tests/08_iot_device_health.test.ts",
    "test:ui:install": "playwright install chromium",
    "test:ui": "playwright test",
    "seed": "tsx scripts/seed-admin.ts",
    "fetch:certs": "node scripts/fetch-certs.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/aws-lambda": "^8.10.147",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "aws-cdk": "^2.1000.0",
    "c8": "^10.1.3",
    "esbuild": "^0.24.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.0.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.0.7"
  },
  "dependencies": {
    "@aws-sdk/client-cloudformation": "^3.731.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.731.0",
    "@aws-sdk/client-dynamodb": "^3.731.0",
    "@aws-sdk/client-iot": "^3.731.0",
    "@aws-sdk/client-iot-data-plane": "^3.1101.0",
    "@aws-sdk/client-lambda": "^3.1101.0",
    "@aws-sdk/client-s3": "^3.731.0",
    "@aws-sdk/client-secrets-manager": "^3.1101.0",
    "@aws-sdk/client-ses": "^3.731.0",
    "@aws-sdk/client-sqs": "^3.731.0",
    "@aws-sdk/client-ssm": "^3.731.0",
    "@aws-sdk/lib-dynamodb": "^3.731.0",
    "@reduxjs/toolkit": "^2.5.0",
    "aws-cdk-lib": "^2.263.0",
    "aws-iot-device-sdk-v2": "^1.28.0",
    "constructs": "^10.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-redux": "^9.2.0",
    "stripe": "latest",
    "zod": "^4.4.3"
  }
}
