# =============================================================================
# CrossBox Gym - Environment Configuration Template
# Copy this file to `.env` and fill in your actual values.
# Variables marked [auto] are normally injected by the CDK stack / integration
# test harness from `cdk-outputs.json`; you only need to set them explicitly
# when running Lambda handlers outside of AWS or outside the test runner.
# =============================================================================

# ------------------------------------------------------------------------------
# AWS / CDK Deployment
# ------------------------------------------------------------------------------
AWS_REGION=eu-central-1
# Stack prefix used to derive DataStack, ApiStack, FrontendStack and IotStack.
# The literal suffix "Stack" is optional (CrossboxGymDev and CrossboxGymDevStack
# both resolve to the same prefix).
STACK_NAME=CrossboxGymDev
# STACKS=all                   # optional: comma-separated stacks for `npm run deploy`
# AWS_ACCOUNT_ID=0000000000  # optional: AWS account for CDK bootstrap

# ------------------------------------------------------------------------------
# Integration Test Credentials
# ------------------------------------------------------------------------------
ADMIN_EMAIL=admin@crossboxgym.com
ADMIN_PASSWORD=Admin123!

# ------------------------------------------------------------------------------
# Stripe (required for checkout & webhook integration tests)
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_...

# EventBridge Partner EventBus Name (from Stripe Dashboard -> Event Destinations).
# Only needed at CDK synth/deploy time if you wire Stripe events to EventBridge.
STRIPE_PARTNER_BUS_NAME=aws.partner/stripe.com/ed_test_...

# ------------------------------------------------------------------------------
# Frontend Builds (Vite)
# ------------------------------------------------------------------------------
# VITE_API_URL=https://<api-id>.execute-api.<region>.amazonaws.com

# ------------------------------------------------------------------------------
# Lambda Runtime [auto]
# ------------------------------------------------------------------------------
# The values below are read from CloudFormation outputs by the integration test
# harness and by the deployed Lambda functions. Uncomment and fill only for
# local handler invocation (e.g. `tsx scripts/some-local-script.ts`).
# MAIN_TABLE_NAME=CrossboxGymDevDataStack-MainTable...
# ENTRY_LOGS_TABLE_NAME=CrossboxGymDevDataStack-EntryLogs...
# AUDIT_LOGS_TABLE_NAME=CrossboxGymDevDataStack-AuditLogs...
# USER_POOL_ID=eu-central-1_xxxxxxxx
# USER_POOL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# FRONTEND_URL=https://xxxxxxxxxxxxxx.cloudfront.net
# ADMIN_FRONTEND_URL=https://xxxxxxxxxxxxxx.cloudfront.net
# PAYMENT_PROVIDER=stripe
# IDENTITY_PROVIDER=cognito
# SES_FROM_EMAIL=noreply@crossgym.fit
# LOCKER_CLIENT_TYPE=mqtt
# LOCKER_THING_NAME=crossbox-locker-relay-01
# IOT_ENDPOINT=xxxxxxxxxxxxx-ats.iot.<region>.amazonaws.com
